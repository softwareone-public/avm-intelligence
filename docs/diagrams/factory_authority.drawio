<mxfile host="app.diagrams.net" modified="2026-10-13T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram name="Authority Map" id="authority-map"><mxGraphModel dx="1600" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="760" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Factory authority: workflows → state → projection → board&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#24292f;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="58" as="geometry" /></mxCell><mxCell id="workflows" value="&lt;b&gt;FACTORY WORKFLOWS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;factory-discovery / manual-discovery&lt;br/&gt;factory-dispatch / manual-dispatch&lt;br/&gt;manual-worker&lt;br/&gt;manual-accept-evidence&lt;br/&gt;manual-site-publish&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Read, claim, seal, accept, publish&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#0969da;strokeColor=#0969da;fontColor=#ffffff;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="320" height="350" as="geometry" /></mxCell><mxCell id="state" value="&lt;b&gt;factory-state&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;requests · attempts · fences&lt;br/&gt;lifecycle + projection intents&lt;br/&gt;acceptance + Pages receipts&lt;br/&gt;per-module delivery checkpoints&lt;br/&gt;&lt;br/&gt;&lt;i&gt;JSON under state/ · expected-head Git writes&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#8250df;strokeColor=#8250df;fontColor=#ffffff;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="360" height="350" as="geometry" /></mxCell><mxCell id="projection" value="&lt;b&gt;factory-projection&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Reads due intents&lt;br/&gt;Writes Issue / Project updates&lt;br/&gt;Acknowledges delivery&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Sole board writer&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#4CC7E8;strokeColor=#4CC7E8;fontColor=#ffffff;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="860" y="170" width="300" height="350" as="geometry" /></mxCell><mxCell id="board" value="&lt;b&gt;HUMAN-FACING BOARD&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;GitHub Project + module Issues&lt;br/&gt;status · summary · labels&lt;br/&gt;human notes preserved&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Projection only; no dispatch or acceptance authority&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1a7f37;strokeColor=#1a7f37;fontColor=#ffffff;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1230" y="170" width="330" height="350" as="geometry" /></mxCell><mxCell id="w-state" value="persist / claim / seal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0969da;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0969da;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="workflows" target="state"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="state-proj" value="due intents" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8250df;strokeWidth=2;endArrow=block;endFill=1;fontColor=#8250df;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state" target="projection"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="proj-board" value="project + acknowledge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4CC7E8;strokeWidth=2;endArrow=block;endFill=1;fontColor=#4CC7E8;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="projection" target="board"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="Rollout boundary: factory-projection is the sole Issue/Project writer; its job is currently hard-disabled in this review branch." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff8c5;strokeColor=#d4a72c;fontColor=#5c4800;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="676" width="1520" height="48" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Artifacts and Main" id="artifacts-and-main"><mxGraphModel dx="1600" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="760" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Evidence becomes accepted data through a reviewed main branch&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#24292f;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="58" as="geometry" /></mxCell><mxCell id="worker" value="&lt;b&gt;WORKFLOW&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;manual-worker&lt;br/&gt;trusted seal after compute" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#0969da;strokeColor=#0969da;fontColor=#ffffff;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="35" y="180" width="235" height="190" as="geometry" /></mxCell><mxCell id="artifact" value="&lt;b&gt;ACTIONS ARTIFACT&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;sealed attempt evidence&lt;br/&gt;exact producer IDs&lt;br/&gt;&lt;i&gt;not canonical data&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#4CC7E8;strokeColor=#4CC7E8;fontColor=#ffffff;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="330" y="180" width="240" height="190" as="geometry" /></mxCell><mxCell id="proposal" value="&lt;b&gt;DATA-ONLY PROPOSAL&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;factory/v2-evidence-*&lt;br/&gt;proposal.json + data/**&lt;br/&gt;exact expected base" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#bf3989;strokeColor=#bf3989;fontColor=#ffffff;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="630" y="180" width="260" height="190" as="geometry" /></mxCell><mxCell id="review" value="&lt;b&gt;HUMAN REVIEW&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Pull request&lt;br/&gt;required checks&lt;br/&gt;review and merge" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b78103;strokeColor=#b78103;fontColor=#ffffff;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="950" y="180" width="220" height="190" as="geometry" /></mxCell><mxCell id="main" value="&lt;b&gt;PROTECTED main&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;accepted data/**&lt;br/&gt;trusted code + config&lt;br/&gt;reviewed PR gate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#24292f;strokeColor=#24292f;fontColor=#ffffff;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1230" y="180" width="325" height="190" as="geometry" /></mxCell><mxCell id="accept" value="&lt;b&gt;manual-accept-evidence&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Requires revalidated artifact IDs&lt;br/&gt;and the exact merged main commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#0969da;strokeColor=#0969da;fontColor=#ffffff;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="480" y="465" width="370" height="150" as="geometry" /></mxCell><mxCell id="state" value="&lt;b&gt;factory-state&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Exact acceptance receipt&lt;br/&gt;Lifecycle handoff" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#8250df;strokeColor=#8250df;fontColor=#ffffff;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="940" y="465" width="300" height="150" as="geometry" /></mxCell><mxCell id="publish" value="&lt;b&gt;PUBLICATION&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;manual-site-publish reads accepted main&lt;br/&gt;Verified Pages receipt returns to factory-state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1a7f37;strokeColor=#1a7f37;fontColor=#ffffff;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1300" y="455" width="255" height="165" as="geometry" /></mxCell><mxCell id="w-art" value="uploads evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0969da;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0969da;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="artifact"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="art-prop" value="export proposal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4CC7E8;strokeWidth=2;endArrow=block;endFill=1;fontColor=#4CC7E8;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="artifact" target="proposal"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="prop-review" value="opens PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#bf3989;strokeWidth=2;endArrow=block;endFill=1;fontColor=#bf3989;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="proposal" target="review"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="review-main" value="human merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b78103;strokeWidth=2;endArrow=block;endFill=1;fontColor=#b78103;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="review" target="main"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="artifact-accept" value="exact artifact IDs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4CC7E8;strokeWidth=2;endArrow=block;endFill=1;fontColor=#4CC7E8;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="artifact" target="accept"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="main-accept" value="exact merge commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b78103;strokeWidth=2;endArrow=block;endFill=1;fontColor=#b78103;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="main" target="accept"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="accept-state" value="verified receipt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8250df;strokeWidth=2;endArrow=block;endFill=1;fontColor=#8250df;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="accept" target="state"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="main-publish" value="accepted dataset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1a7f37;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a7f37;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="main" target="publish"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="Artifacts prove what ran; main records reviewed data; factory-state records lifecycle and verified receipts. These are separate authorities." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff8c5;strokeColor=#d4a72c;fontColor=#5c4800;fontSize=17;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="676" width="1520" height="48" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>