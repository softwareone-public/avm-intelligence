mands/&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 237, 179);&quot; title=&quot;Planned stage: recovery&quot;&gt;{command-id}.json&lt;/span&gt;&lt;br&gt;        outboxes/&lt;br&gt;          &lt;span style=&quot;background-color: rgb(255, 237, 179);&quot; title=&quot;Planned stage: selectionexport&quot;&gt;selections/&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 237, 179);&quot; title=&quot;Planned stage: selectionexport&quot;&gt;{export-id}.json&lt;/span&gt;&lt;br&gt;          &lt;span style=&quot;background-color: rgb(255, 237, 179);&quot; title=&quot;Planned stage: receipts&quot;&gt;wakeups/&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 237, 179);&quot; title=&quot;Planned stage: receipts&quot;&gt;{wakeup-id}.json&lt;/span&gt;&lt;br&gt;        &lt;span style=&quot;background-color: rgb(255, 237, 179);&quot; title=&quot;Planned stage: projection&quot;&gt;projection/&lt;/span&gt;&lt;br&gt;          &lt;span style=&quot;background-color: rgb(255, 237, 179);&quot; title=&quot;Planned stage: projection&quot;&gt;binding.json&lt;/span&gt;&lt;br&gt;          &lt;span style=&quot;background-color: rgb(255, 237, 179);&quot; title=&quot;Planned stage: projection&quot;&gt;delivery.json&lt;/span&gt;&lt;br&gt;          &lt;span style=&quot;background-color: rgb(255, 237, 179);&quot; title=&quot;Planned stage: projection&quot;&gt;intent.json&lt;/span&gt;&lt;br&gt;          &lt;span style=&quot;background-color: rgb(255, 237, 179);&quot; title=&quot;Planned stage: projection&quot;&gt;lifecycle.json&lt;/span&gt;&lt;br&gt;        publications/&lt;br&gt;          &lt;span style=&quot;background-color: rgb(255, 237, 179);&quot; title=&quot;Planned stage: receipts&quot;&gt;evidence/&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 237, 179);&quot; title=&quot;Planned stage: receipts&quot;&gt;{receipt-id}.json&lt;/span&gt;&lt;br&gt;        &lt;span style=&quot;background-color: rgb(201, 221, 255);&quot; title=&quot;factory-dispatc