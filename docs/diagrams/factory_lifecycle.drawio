        <mxCell id="RtSwCuXH9fdABtDjKVE_-85" parent="RtSwCuXH9fdABtDjKVE_-84" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#315d29;" value="&lt;b&gt;factory-state | common module-v2 ownership&lt;/b&gt;&lt;br&gt;&lt;pre&gt;state/&#xa;  global/&#xa;    &lt;span style=&quot;background-color:#dae8fc;&quot; title=&quot;factory-discovery&quot;&gt;catalog/&lt;/span&gt;&#xa;    &lt;span style=&quot;background-color:#dae8fc;&quot; title=&quot;factory-discovery&quot;&gt;discovery/&lt;/span&gt;&#xa;    &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: receipts&quot;&gt;inputs/&lt;/span&gt;&#xa;    &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: recovery&quot;&gt;operations/&lt;/span&gt;&#xa;    outboxes/&#xa;    &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: projection&quot;&gt;projection/&lt;/span&gt;&#xa;    &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: publication&quot;&gt;publications/&lt;/span&gt;&#xa;    &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: recovery&quot;&gt;controls.json&lt;/span&gt;&#xa;    transaction.json&#xa;  modules/&#xa;    ptn/avm-ptn-aks-enterprise/&#xa;    res/avm-res-resources-resourcegroup/&#xa;        attempts/&#xa;          {request-id}/&#xa;            {attempt-id}.json&#xa;        &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: recovery&quot;&gt;operations/&lt;/span&gt;&#xa;          &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: recovery&quot;&gt;commands/&lt;/span&gt;&#xa;            &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: recovery&quot;&gt;{command-id}.json&lt;/span&gt;&#xa;        outboxes/&#xa;          &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: selectionexport&quot;&gt;selections/&lt;/span&gt;&#xa;            &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: selectionexport&quot;&gt;{export-id}.json&lt;/span&gt;&#xa;          &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: receipts&quot;&gt;wakeups/&lt;/span&gt;&#xa;            &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: receipts&quot;&gt;{wakeup-id}.json&lt;/span&gt;&#xa;        &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: projection&quot;&gt;projection/&lt;/span&gt;&#xa;          &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: projection&quot;&gt;binding.json&lt;/span&gt;&#xa;          &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: projection&quot;&gt;delivery.json&lt;/span&gt;&#xa;          &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: projection&quot;&gt;intent.json&lt;/span&gt;&#xa;          &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: projection&quot;&gt;lifecycle.json&lt;/span&gt;&#xa;        publications/&#xa;          &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: receipts&quot;&gt;evidence/&lt;/span&gt;&#xa;            &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: receipts&quot;&gt;{receipt-id}.json&lt;/span&gt;&#xa;        &lt;span style=&quot;background-color:#d5e8d4;&quot; title=&quot;factory-dispatch&quot;&gt;requests/&lt;/span&gt;&#xa;          &lt;span style=&quot;background-color:#d5e8d4;&quot; title=&quot;factory-dispatch&quot;&gt;{request-id}.json&lt;/span&gt;&#xa;        &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: selection&quot;&gt;selections/&lt;/span&gt;&#xa;          &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: selection&quot;&gt;{context}/&lt;/span&gt;&#xa;            &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: selection&quot;&gt;{selection-id}.json&lt;/span&gt;&#xa;        &lt;span style=&quot;background-color:#dae8fc;&quot; title=&quot;factory-discovery&quot;&gt;source/&lt;/span&gt;&#xa;          &lt;span style=&quot;background-color:#dae8fc;&quot; title=&quot;factory-discovery&quot;&gt;pins.json&lt;/span&gt;&#xa;        &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: receipts&quot;&gt;assessment-inputs.json&lt;/span&gt;&#xa;        &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: recovery&quot;&gt;controls.json&lt;/span&gt;&#xa;        transaction.json&#xa;    utl/avm-utl-regions/&#xa;  providers/  # Proposed contract extension&#xa;    &amp;lt;registry&amp;gt;/&amp;lt;namespace&amp;gt;/&amp;lt;provider&amp;gt;/&#xa;    registry.terraform.io/&#xa;      hashicorp/&#xa;        azurerm/&#xa;          actions/  # No AzureRM example; coverage unverified&#xa;          datasources/&#xa;            azurerm_client_config/&#xa;              &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: providercollection&quot;&gt;requirements/&lt;/span&gt;&#xa;                &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: providercollection&quot;&gt;{requirement-id}.json&lt;/span&gt;&#xa;          ephemerals/&#xa;            azurerm_key_vault_secret/&#xa;              &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: providercollection&quot;&gt;requirements/&lt;/span&gt;&#xa;                &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: providercollection&quot;&gt;{id}.json&lt;/span&gt;&#xa;          functions/&#xa;            parse_resource_id/&#xa;              &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: providercollection&quot;&gt;requirements/&lt;/span&gt;&#xa;                &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: providercollection&quot;&gt;{id}.json&lt;/span&gt;&#xa;          resources/&#xa;            azurerm_resource_group/&#xa;              &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: providercollection&quot;&gt;requirements/&lt;/span&gt;&#xa;                &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: providercollection&quot;&gt;{requirement-id}.json&lt;/span&gt;&#xa;          versions/&#xa;            {version}/&#xa;              &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: providercollection&quot;&gt;attempts/&lt;/span&gt;&#xa;                &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: providercollection&quot;&gt;{attempt-id}.json&lt;/span&gt;&#xa;              &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: receipts&quot;&gt;receipts/&lt;/span&gt;&#xa;                &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: receipts&quot;&gt;{receipt-id}.json&lt;/span&gt;&#xa;              &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: providercollection&quot;&gt;requests/&lt;/span&gt;&#xa;                &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: providercollection&quot;&gt;{request-id}.json&lt;/span&gt;&#xa;              &lt;span style=&quot;background-color:#fff2cc;&quot; title=&quot;Planned stage: receipts&quot;&gt;readiness.json&lt;/span&gt;&#xa;  layout.json&lt;/pre&gt;Module/global paths follow the common contract; provider ownership is proposed. Braces denote illustrative IDs. Requirements and requests pin source kind, exact target versions and dependent assessments. Source-specific readiness references accepted receipts; collectors never overwrite curation. Named provider types are user-supplied examples, not coverage claims. Expected-head transactions; App-only authority." vertex="1">
