{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/softwareone-public/avm-intelligence/blob/main/schemas/normalized-analysis-v1.schema.json",
  "title": "AVM Intelligence normalized analysis version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_version", "provenance", "ruleset_name", "ruleset_digest", "source_digest", "units"],
  "properties": {
    "schema_version": {"const": 2},
    "adapter_version": {"const": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "source_sha", "cli_version", "cli_commit", "adapter_version"],
      "properties": {
        "module_id": {"type": "string", "minLength": 1},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "cli_version": {"type": "string", "minLength": 1},
        "cli_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "adapter_version": {"const": 1}
      }
    },
    "ruleset_name": {"type": "string", "minLength": 1},
    "ruleset_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "classification", "checks", "symbol_count"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["component", "example"]},
          "owner": {"type": "string"},
          "owner_scope": {"enum": ["component", "repository"]},
          "classification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "method", "reason"],
            "properties": {
              "kind": {"enum": ["module", "deployment", "unknown"]},
              "method": {"enum": ["override", "go", "conflict", "unavailable", "prepared", "jev"]},
              "reason": {"type": "string"}
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "engine", "status", "severity", "message"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "engine": {"enum": ["go", "jev"]},
                "status": {"enum": ["pass", "fail", "unchecked", "not_applicable"]},
                "severity": {"enum": ["info", "warning", "error"]},
                "message": {"type": "string"},
                "evidence": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "symbol_count": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
