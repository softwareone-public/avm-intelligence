{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/softwareone-public/avm-intelligence/blob/main/schemas/factory-data-v2.schema.json",
  "title": "AVM Intelligence factory data records version 2",
  "description": "Strict contracts for immutable factory evidence, operational handoffs, snapshots, selections, and receipts. Legacy normalized-analysis-v1 remains a separate historical reader contract.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/sealedCompletion"
    },
    {
      "$ref": "#/$defs/sourceRevision"
    },
    {
      "$ref": "#/$defs/moduleMetadata"
    },
    {
      "$ref": "#/$defs/moduleVersionObservation"
    },
    {
      "$ref": "#/$defs/moduleVersionsIndex"
    },
    {
      "$ref": "#/$defs/facts"
    },
    {
      "$ref": "#/$defs/provenance"
    },
    {
      "$ref": "#/$defs/dimensionDefinition"
    },
    {
      "$ref": "#/$defs/checkDefinition"
    },
    {
      "$ref": "#/$defs/dimensionResult"
    },
    {
      "$ref": "#/$defs/analysis"
    },
    {
      "$ref": "#/$defs/providerSnapshot"
    },
    {
      "$ref": "#/$defs/coreFunctionSnapshot"
    },
    {
      "$ref": "#/$defs/moduleEvidenceProposal"
    },
    {
      "$ref": "#/$defs/catalogProposal"
    },
    {
      "$ref": "#/$defs/providerSnapshotProposal"
    },
    {
      "$ref": "#/$defs/moduleObservationProposal"
    },
    {
      "$ref": "#/$defs/selectionExportProposal"
    },
    {
      "$ref": "#/$defs/presentationProposal"
    },
    {
      "$ref": "#/$defs/selectionReceipt"
    },
    {
      "$ref": "#/$defs/presentationSnapshot"
    },
    {
      "$ref": "#/$defs/datasetManifest"
    },
    {
      "$ref": "#/$defs/deploymentReceipt"
    }
  ],
  "$defs": {
    "moduleId": {
      "type": "string",
      "pattern": "^avm-(res|ptn|utl)-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recordId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*-[0-9a-f]{64}$"
    },
    "safeRelativePath": {
      "type": "string",
      "pattern": "^(?:\\.|[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*)$"
    },
    "recordBase": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        }
      },
      "required": [
        "schema_version"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "contract_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/sha1"
        },
        "binary_digest": {
          "$ref": "#/$defs/sha256"
        },
        "contract_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "complete",
        "observed_at"
      ],
      "properties": {
        "capabilities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "complete",
              "partial",
              "unavailable",
              "unknown"
            ]
          }
        },
        "complete": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "providerTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "version",
        "snapshot_id"
      ],
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "$ref": "#/$defs/recordId"
        }
      }
    },
    "providerAddress": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*/[A-Za-z0-9_-][A-Za-z0-9_.-]*/[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "execution",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unchecked",
            "not_applicable"
          ]
        },
        "execution": {
          "enum": [
            "completed",
            "disabled",
            "unselected",
            "missing_input",
            "error"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "message": {
          "type": "string"
        },
        "error_class": {
          "type": "string"
        }
      }
    },
    "request": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "record_type",
            "request_id",
            "kind",
            "module_id",
            "context_id",
            "desired_generation",
            "input_fingerprint",
            "phase",
            "fence",
            "created_at",
            "updated_at"
          ],
          "properties": {
            "schema_version": {
              "const": 2
            },
            "record_type": {
              "const": "request"
            },
            "request_id": {
              "$ref": "#/$defs/recordId"
            },
            "kind": {
              "enum": [
                "acquire_source",
                "assess"
              ]
            },
            "module_id": {
              "$ref": "#/$defs/moduleId"
            },
            "context_id": {
              "type": "string",
              "minLength": 1
            },
            "desired_generation": {
              "type": "integer",
              "minimum": 1
            },
            "source_sha": {
              "oneOf": [
                {
                  "$ref": "#/$defs/sha1"
                },
                {
                  "type": "null"
                }
              ]
            },
            "facts_id": {
              "oneOf": [
                {
                  "$ref": "#/$defs/recordId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "definition_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/recordId"
              }
            },
            "provider_targets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/providerTarget"
              }
            },
            "input_fingerprint": {
              "$ref": "#/$defs/sha256"
            },
            "phase": {
              "enum": [
                "ready",
                "claimed",
                "dispatched",
                "running",
                "awaiting_acceptance",
                "retryable",
                "needs_review",
                "completed"
              ]
            },
            "attempt_id": {
              "$ref": "#/$defs/recordId"
            },
            "owner_run_id": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "lease_expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "fence": {
              "type": "integer",
              "minimum": 0
            },
            "retry_class": {
              "enum": [
                "none",
                "transient",
                "source",
                "validation",
                "permission",
                "policy"
              ]
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {"kind": {"const": "acquire_source"}},
                "required": ["kind"]
              },
              "then": {
                "required": ["source_sha", "facts_id"],
                "properties": {
                  "source_sha": {"$ref": "#/$defs/sha1"},
                  "facts_id": {"type": "null"}
                }
              }
            },
            {
              "if": {
                "properties": {"kind": {"const": "assess"}},
                "required": ["kind"]
              },
              "then": {
                "required": ["facts_id"],
                "properties": {"facts_id": {"$ref": "#/$defs/recordId"}}
              }
            }
          ]
        }
      ]
    },
    "sealedCompletion": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "record_type",
            "completion_id",
            "request_id",
            "attempt_id",
            "input_fingerprint",
            "fence",
            "producer",
            "artifact_digest",
            "validation",
            "sealed_at"
          ],
          "properties": {
            "schema_version": {
              "const": 2
            },
            "record_type": {
              "const": "sealed_completion"
            },
            "completion_id": {
              "$ref": "#/$defs/recordId"
            },
            "request_id": {
              "$ref": "#/$defs/recordId"
            },
            "attempt_id": {
              "$ref": "#/$defs/recordId"
            },
            "input_fingerprint": {
              "$ref": "#/$defs/sha256"
            },
            "fence": {
              "type": "integer",
              "minimum": 1
            },
            "producer": {
              "$ref": "#/$defs/producer"
            },
            "artifact_digest": {
              "$ref": "#/$defs/sha256"
            },
            "validation": {
              "enum": [
                "accepted",
                "rejected"
              ]
            },
            "validation_reason": {
              "type": "string"
            },
            "sealed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "moduleMetadata": {
      "allOf": [
        {"$ref": "#/$defs/recordBase"},
        {"type": "object", "additionalProperties": false,
          "required": ["schema_version", "record_type", "module_id", "module_type", "status", "repository", "lifecycle", "display_name", "description", "missing_observations", "last_seen_generation"],
          "properties": {
            "schema_version": {"const": 2}, "record_type": {"const": "module_metadata"},
            "module_id": {"$ref": "#/$defs/moduleId"},
            "module_type": {"enum": ["res", "ptn", "utl"]},
            "status": {"type": "string", "minLength": 1},
            "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "lifecycle": {"enum": ["active", "retired"]},
            "display_name": {"type": "string", "minLength": 1},
            "registry_url": {"type": "string"},
            "alternative_names": {"type": "string"},
            "description": {"type": "string"},
            "comments": {"type": "string"},
            "first_published": {"type": "string"},
            "provider_namespace": {"type": "string"},
            "resource_type": {"type": "string"},
            "parent_module": {"type": "string"},
            "primary_owner_handle": {"type": "string"},
            "primary_owner_name": {"type": "string"},
            "secondary_owner_handle": {"type": "string"},
            "secondary_owner_name": {"type": "string"},
            "missing_observations": {"type": "integer", "minimum": 0},
            "last_seen_generation": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "sourceRevision": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "record_type",
            "module_id",
            "repository",
            "source_sha",
            "immutable"
          ],
          "properties": {
            "schema_version": {
              "const": 2
            },
            "record_type": {
              "const": "source_revision"
            },
            "module_id": {
              "$ref": "#/$defs/moduleId"
            },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "source_sha": {
              "$ref": "#/$defs/sha1"
            },
            "immutable": {
              "const": true
            }
          }
        }
      ]
    },
    "moduleVersionObservation": {
      "allOf": [
        {"$ref": "#/$defs/recordBase"},
        {"type": "object", "additionalProperties": false,
          "required": ["schema_version", "record_type", "observation_id", "module_id", "generation", "repository", "version", "tags", "source_sha", "observed_at", "immutable"],
          "properties": {
            "schema_version": {"const": 2}, "record_type": {"const": "module_version_observation"},
            "observation_id": {"$ref": "#/$defs/recordId"}, "module_id": {"$ref": "#/$defs/moduleId"},
            "generation": {"type": "integer", "minimum": 1},
            "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "version": {"type": "string", "minLength": 1},
            "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "source_sha": {"$ref": "#/$defs/sha1"}, "observed_at": {"type": "string", "format": "date-time"},
            "immutable": {"const": true}
          }
        }
      ]
    },
    "moduleVersionsIndex": {
      "allOf": [
        {"$ref": "#/$defs/recordBase"},
        {"type": "object", "additionalProperties": false,
          "required": ["schema_version", "record_type", "module_id", "generation", "observation_ids", "overall_latest"],
          "properties": {
            "schema_version": {"const": 2}, "record_type": {"const": "module_versions_index"},
            "module_id": {"$ref": "#/$defs/moduleId"}, "generation": {"type": "integer", "minimum": 1},
            "observation_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/recordId"}},
            "overall_latest": {"type": ["object", "null"], "additionalProperties": false, "required": ["version", "tag", "source_sha", "observation_id"], "properties": {"version": {"type": "string"}, "tag": {"type": "string"}, "source_sha": {"$ref": "#/$defs/sha1"}, "observation_id": {"$ref": "#/$defs/recordId"}}}
          }
        }
      ]
    },
    "factSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "capability"
      ],
      "properties": {
        "kind": {
          "enum": [
            "resource",
            "data",
            "ephemeral",
            "function",
            "action",
            "provider",
            "module_call",
            "variable",
            "output"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider_address": {
          "type": "string"
        },
        "local_provider_name": {
          "type": "string"
        },
        "alias": {
          "type": "string"
        },
        "module_source": {
          "type": "string"
        },
        "module_version": {
          "type": "string"
        },
        "unit_path": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "line"
          ],
          "properties": {
            "file": {
              "$ref": "#/$defs/safeRelativePath"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "capability": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "facts": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "record_type",
            "facts_id",
            "module_id",
            "source_sha",
            "units",
            "coverage",
            "content_digest"
          ],
          "properties": {
            "schema_version": {
              "const": 2
            },
            "record_type": {
              "const": "facts"
            },
            "facts_id": {
              "$ref": "#/$defs/recordId"
            },
            "module_id": {
              "$ref": "#/$defs/moduleId"
            },
            "source_sha": {
              "$ref": "#/$defs/sha1"
            },
            "units": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "role",
                  "symbols"
                ],
                "properties": {
                  "path": {
                    "$ref": "#/$defs/safeRelativePath"
                  },
                  "role": {
                    "enum": [
                      "component",
                      "child_component",
                      "example"
                    ]
                  },
                  "owner": {
                    "$ref": "#/$defs/safeRelativePath"
                  },
                  "symbols": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/factSymbol"
                    }
                  }
                }
              }
            },
            "coverage": {
              "$ref": "#/$defs/coverage"
            },
            "content_digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "provenance": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "record_type",
            "provenance_id",
            "module_id",
            "source_sha",
            "producer",
            "facts_id",
            "input_fingerprint",
            "capabilities",
            "recorded_at"
          ],
          "properties": {
            "schema_version": {
              "const": 2
            },
            "record_type": {
              "const": "producer_provenance"
            },
            "provenance_id": {
              "$ref": "#/$defs/recordId"
            },
            "module_id": {
              "$ref": "#/$defs/moduleId"
            },
            "source_sha": {
              "$ref": "#/$defs/sha1"
            },
            "facts_id": {
              "$ref": "#/$defs/recordId"
            },
            "producer": {
              "$ref": "#/$defs/producer"
            },
            "input_fingerprint": {
              "$ref": "#/$defs/sha256"
            },
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "dimensionDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "record_type",
            "definition_id",
            "dimension_id",
            "version",
            "unit_scope",
            "check_ids",
            "required_capabilities",
            "policy_id",
            "evidence_schema_version"
          ],
          "properties": {
            "schema_version": {
              "const": 2
            },
            "record_type": {
              "const": "dimension_definition"
            },
            "definition_id": {
              "$ref": "#/$defs/recordId"
            },
            "dimension_id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "unit_scope": {
              "enum": [
                "component",
                "child_component",
                "example",
                "repository"
              ]
            },
            "check_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "required_capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "policy_id": {
              "$ref": "#/$defs/recordId"
            },
            "evidence_schema_version": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "checkDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "record_type",
            "check_id",
            "version",
            "dimension_id",
            "applicability",
            "required_capabilities",
            "evidence_schema_version",
            "implementation_id"
          ],
          "properties": {
            "schema_version": {
              "const": 2
            },
            "record_type": {
              "const": "check_definition"
            },
            "check_id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "dimension_id": {
              "type": "string",
              "minLength": 1
            },
            "applicability": {
              "type": "string",
              "minLength": 1
            },
            "required_capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidence_schema_version": {
              "type": "integer",
              "minimum": 1
            },
            "implementation_id": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            }
          }
        }
      ]
    },
    "dimensionResult": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "record_type",
            "dimension_result_id",
            "module_id",
            "source_sha",
            "unit_path",
            "facts_id",
            "definition_id",
            "input_fingerprint",
            "checks",
            "coverage",
            "execution_complete",
            "freshness"
          ],
          "properties": {
            "schema_version": {
              "const": 2
            },
            "record_type": {
              "const": "dimension_result"
            },
            "dimension_result_id": {
              "$ref": "#/$defs/recordId"
            },
            "module_id": {
              "$ref": "#/$defs/moduleId"
            },
            "source_sha": {
              "$ref": "#/$defs/sha1"
